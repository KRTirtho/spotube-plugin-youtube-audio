import "module:spotube_plugin" as spotube_plugin
import "module:std" as std

var YouTubeEngine = spotube_plugin.YouTubeEngine

class Converter {
  static fun toSpotubeMatchObject(res: List) -> List {
    return res.map((d) => {
      return {
        "id": d["id"],
        "title": d["title"],
        "artists": [d["author"]],
        "duration": d["duration"],
        "thumbnail": d["thumbnail"],
        "externalUri": "https://youtube.com/watch?v=${d["id"]}",
      }
    }).toList()
  }
}

class AudioSourceEndpoint {
  var yt

  construct() {
    yt = YouTubeEngine()
  }

  get supportedPresets -> List {
    return [
      {
        type: "lossy",
        name: "mp4",
        qualities: [
          { bitrate: 256000 },
          { bitrate: 128000 },
          { bitrate: 96000 },
          { bitrate: 44000 }
        ]
      },
      {
        type: "lossy",
        name: "webm",
        qualities: [
          { bitrate: 256000 },
          { bitrate: 128000 },
          { bitrate: 96000 },
          { bitrate: 44000 }
        ]
      }
    ]
  }

  fun matches(track: Map) {
    var artists = track["artists"]
      .map((a) => a["name"])
      .join(", ")

    var hasISRC =
      track["isrc"] != null &&
      track["isrc"].isNotEmpty

    return yt.search(
      hasISRC
        ? track["isrc"]
        : "${track["name"]} ${artists}"
    ).then((res) => {
      if (res.isEmpty && hasISRC) {
        return yt.search(
          "${track["name"]} ${artists}"
        ).then((fallback) => {
          return Converter.toSpotubeMatchObject(fallback)
        })
      }

      return Converter.toSpotubeMatchObject(res)
    })
  }

  fun streams(match: Map) {
    return yt.streamManifest(match["id"]).then((manifest) => {
      return manifest.map((stream) => {
        return {
          "url": stream["url"],
          "container": stream["container"],
          "type": "lossy",
          "codec": "aac",
          "bitrate": stream["bitrate"],
        }
      }).toList()
    })
  }
}

export { AudioSourceEndpoint }
